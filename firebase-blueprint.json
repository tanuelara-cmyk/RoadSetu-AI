{
  "entities": {
    "users": {
      "fields": {
        "uid": { "type": "string", "description": "Unique user identifier" },
        "name": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "description": "User's verified email address" },
        "role": { "type": "string", "description": "Role: citizen, authority, or contractor" },
        "createdAt": { "type": "string", "description": "User registration timestamp" },
        "updatedAt": { "type": "string", "description": "Profile update timestamp" }
      }
    },
    "potholes": {
      "fields": {
        "complaintId": { "type": "string", "description": "Unique civic complaint ID (e.g. PTH-2026-00142)" },
        "potholeId": { "type": "string", "description": "Alias for complaintId" },
        "citizenId": { "type": "string", "description": "Unique user ID of reporting citizen" },
        "citizenName": { "type": "string", "description": "Full name of reporting citizen" },
        "reportedBy": { "type": "object", "description": "Citizen metadata object (uid, name, email)" },
        "originalImage": { "type": "string", "description": "Initial citizen pothole photograph" },
        "beforeImageUrl": { "type": "string", "description": "Alias for originalImage" },
        "address": { "type": "string", "description": "Reverse geocoded human-readable location address" },
        "latitude": { "type": "number", "description": "Internal GPS latitude for spatial matching" },
        "longitude": { "type": "number", "description": "Internal GPS longitude for spatial matching" },
        "landmark": { "type": "string", "description": "Nearby landmark reference" },
        "severity": { "type": "string", "description": "Low, Medium, High, or Critical" },
        "description": { "type": "string", "description": "Citizen description of road hazard" },
        "status": { "type": "string", "description": "Reported, Assigned, Repair In Progress, Repair Claimed, AI Verification, Verified, Suspicious, Failed, Resolved" },
        "contractorId": { "type": "string", "description": "Assigned contractor user UID" },
        "contractorName": { "type": "string", "description": "Assigned contractor full name" },
        "assignedContractor": { "type": "object", "description": "Contractor metadata object" },
        "repairImage": { "type": "string", "description": "Contractor repair evidence photograph" },
        "afterImageUrl": { "type": "string", "description": "Alias for repairImage" },
        "afterLatitude": { "type": "number", "description": "Contractor repair GPS latitude" },
        "afterLongitude": { "type": "number", "description": "Contractor repair GPS longitude" },
        "afterTimestamp": { "type": "string", "description": "Contractor repair timestamp" },
        "repairDescription": { "type": "string", "description": "Contractor repair description" },
        "materialsUsed": { "type": "string", "description": "Materials used in repair" },
        "verificationResult": { "type": "object", "description": "Multi-factor AI verification score and details" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" }
      }
    },
    "verification": {
      "fields": {
        "verificationId": { "type": "string", "description": "Unique verification audit ID" },
        "potholeId": { "type": "string", "description": "Associated pothole ID" },
        "potholeRegionScore": { "type": "number", "description": "Region matching confidence (0-100)" },
        "gpsScore": { "type": "number", "description": "GPS proximity consistency score (0-100)" },
        "viewpointScore": { "type": "number", "description": "Camera angle and perspective score (0-100)" },
        "backgroundMatchScore": { "type": "number", "description": "Background landmarks and structures match (0-100)" },
        "repairEvidenceScore": { "type": "number", "description": "Surface repair and flushness score (0-100)" },
        "evidenceQualityScore": { "type": "number", "description": "Lighting, clarity, and resolution quality (0-100)" },
        "overallVerificationScore": { "type": "number", "description": "Weighted multi-factor verification confidence (0-100)" },
        "verificationStatus": { "type": "string", "description": "VERIFIED or REINSPECTION REQUIRED" },
        "explanation": { "type": "string", "description": "Human-readable reasoning for civic transparency" },
        "createdAt": { "type": "string", "description": "Analysis completion timestamp" }
      }
    },
    "events": {
      "fields": {
        "eventId": { "type": "string", "description": "Unique immutable event ID" },
        "potholeId": { "type": "string", "description": "Associated pothole ID" },
        "eventType": { "type": "string", "description": "Event classification (e.g. REPORTED, ASSIGNED, REPAIR_CLAIMED, VERIFIED, DISPUTE_RAISED)" },
        "performedBy": { "type": "object", "description": "User or system agent who performed the action" },
        "description": { "type": "string", "description": "Detailed explanation of the timeline event" },
        "timestamp": { "type": "string", "description": "Event timestamp" }
      }
    }
  }
}

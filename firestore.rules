rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAuthority() {
      return isAuthenticated() && getUserData().role == 'authority';
    }
    
    function isContractor() {
      return isAuthenticated() && getUserData().role == 'contractor';
    }

    // Users collection: readable by authenticated users; users cannot modify their own role
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.role in ['citizen', 'contractor'];
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Potholes collection:
    // Anyone can read (public civic transparency)
    // Citizens can create reports (initial fields)
    // Contractors can ONLY update afterImageUrl, afterLatitude, afterLongitude, afterTimestamp, repairDescription, materialsUsed
    // Original citizen fields (beforeImageUrl, latitude, longitude, beforeTimestamp) are strictly immutable!
    match /potholes/{potholeId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && 
                    request.resource.data.potholeId == potholeId &&
                    request.resource.data.reportedBy.uid == request.auth.uid &&
                    request.resource.data.status == 'Reported';
                    
      allow update: if isAuthenticated() && (
        // Authorities can update status, assignments
        isAuthority() ||
        // Contractor assigned to pothole can submit repair evidence (IMMUTABLE original evidence check)
        (
          isContractor() &&
          request.resource.data.beforeImageUrl == resource.data.beforeImageUrl &&
          request.resource.data.latitude == resource.data.latitude &&
          request.resource.data.longitude == resource.data.longitude &&
          request.resource.data.beforeTimestamp == resource.data.beforeTimestamp &&
          request.resource.data.status in ['Repair In Progress', 'Repair Claimed']
        ) ||
        // Citizen who reported can raise a dispute
        (
          isOwner(resource.data.reportedBy.uid) &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.beforeImageUrl == resource.data.beforeImageUrl
        )
      );
      
      allow delete: if isAuthority();
    }

    // Verification records: immutable public audit log; only authorities or server verification can write
    match /verification/{verificationId} {
      allow read: if true;
      allow create, update: if isAuthority();
      allow delete: if false;
    }

    // Activity timeline events: immutable append-only event trail
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Users collection:
    // Any authenticated user can read profiles (e.g. to see contractor or citizen names)
    // Users create their own profile document with role
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Potholes collection:
    // Citizens can only view their own complaints
    // Contractors can only view complaints assigned to them
    // Municipal authorities can view all complaints
    match /potholes/{potholeId} {
      allow read: if isAuthenticated() && (
        resource.data.citizenId == request.auth.uid ||
        resource.data.reportedBy.uid == request.auth.uid ||
        resource.data.contractorId == request.auth.uid ||
        resource.data.assignedContractor.uid == request.auth.uid ||
        getUserData().role == 'authority'
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.citizenId == request.auth.uid ||
        request.resource.data.reportedBy.uid == request.auth.uid
      );
                    
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && getUserData().role == 'authority';
    }

    // Verification records: readable by authenticated users; updateable during verification
    match /verification/{verificationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Activity timeline events: immutable append-only civic audit trail
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}

